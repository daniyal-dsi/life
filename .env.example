# Copy to .env.local for local development. On Vercel, the Supabase integration
# sets NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY, which also work;
# or add these under
# Project Settings > Environment Variables instead. Never commit real values.
# Both are in Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Reminders (Web Push). Public key only; make it with
#   node scripts/generate-reminder-keys.mjs
# The private key goes in Supabase Edge Function secrets, never here.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
